NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173,http://localhost:5174
MONGODB_URI=mongodb://127.0.0.1:27017/consultbook?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ConsultBook Live <noreply@example.com>
ADMIN_NAME=ConsultBook Admin
ADMIN_EMAIL=admin@consultbook.local
ADMIN_PASSWORD=change-this-local-admin-password
CUSTOMER_NAME=Sample Customer
CUSTOMER_EMAIL=customer@consultbook.local
CUSTOMER_PASSWORD=change-this-local-customer-password
